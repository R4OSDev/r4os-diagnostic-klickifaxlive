R4OS_MODULE_MANIFEST=2
KIND=R4X
NAME=KFXLIVE
VERSION=0.2.26
LANGUAGE=Zig
SDK_PROFILE=r4os-zig-generation2
SOURCE=src/main.zig
ENTRY_MODE=app
APP_CLASS=console
TARGET=/R4OS/SOFTWARE/TERMINAL/DIAG/KFXLIVE.R4X
IMAGE_SCOPE=none
OPTIMIZE=speed
META=memory.profile=browser
IMPORT=R4SYS:Query2:2
IMPORT=R4NET:Query2:2
IMPORT=R4DEV:Query2:2
IMPORT=R4IMG:Query2:2
IMPORT=R4IMG:API_V1:1
ZIG_MODULE=r4img:../../Libraries/R4IMG/Bindings/Zig/r4img.zig
META=app.role=diagnostic
META=diagnostic.name=KFXLIVE
META=feature=image-decoder-probe
META=feature=svg-decoder-probe
META=feature=web-runtime-live-probe
META=feature=lazy-javascript-realm
